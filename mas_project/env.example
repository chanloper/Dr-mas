# Configuration guide only. Fill values in a private .env or deployment secrets.
# Do not commit real credentials. This file intentionally contains no values.
PORT=

# Required session signing secret. Generate at least 32 random bytes and encode
# as hex (64 characters). At least 32 non-whitespace characters are enforced.
# Missing/short values stop startup before database or HTTP initialization.
SESSION_SECRET=

# Database settings: ask the authorized operator for the correct environment.
DB_HOST=
DB_USER=
DB_PASS=
# The current web server uses its fixed database name; DB_NAME is not consumed.
DB_NAME=

# API credentials belong only in private runtime configuration.
GEMINI_API_KEY=
PUBLIC_API_KEY=
KAKAO_REST_API_KEY=
