<!--
  * =================================================================================
  * [MAS: Medical Assistant 시스템] 애플리케이션 메인 엔트리 포인트 (main.ejs)
  * 설계 및 엔지니어링 목적:
  * 1. 시스템의 최상위 루트 경로('/') 접속 시 최초로 렌더링되는 진입점(Entry Point) 역할 수행
  * 2. 사용자 인증(로그인) 및 신규 자원 생성(회원가입) 라우팅을 위한 1차 네비게이션 허브 구축
  * 3. 모바일 퍼스트(Mobile-First) 패러다임에 입각한 반응형(Responsive) 웹 레이아웃 설계 적용
  * 학과 및 학년: 컴퓨터공학 / 소프트웨어 전공 3~4학년 종합설계(캡스톤 디자인) 기말 제출 규격
  * =================================================================================
-->
<!DOCTYPE html> <!-- HTML5 표준 문서 규격 선언 (렌더링 최적화 보장) -->
<html lang="ko"> <!-- 브라우저 텍스트 렌더링 엔진 최적화 및 접근성 향상을 위한 한국어(ko) 명시 -->
<head>
    <meta charset="UTF-8"> <!-- 다국어 및 한글 데이터의 무결성을 보장하는 UTF-8 유니코드 인코딩 선언 -->
    
    <!-- 모바일 디바이스 해상도에 맞춘 동적 뷰포트 스케일링을 통해 UI 깨짐 현상을 방지하는 메타 태그 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MAS - 지능형 의료 비서</title> <!-- 클라이언트 브라우저 탭 타이틀(문서 제목) 셋업 -->
    
    <!-- 🎨 관심사의 분리(SoC, Separation of Concerns) 패턴을 적용한 정적 스타일시트 동적 로드 -->
    <link rel="stylesheet" href="/css/style.css">
    
    <!-- 경량화된 벡터 그래픽 기반의 헬스케어 아이콘 렌더링을 위한 FontAwesome 패키지 비동기 로드(CDN) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>

    <!-- 📱 디바이스의 물리적 해상도와 무관하게 컴포넌트를 중앙 정렬하는 래퍼(Wrapper) 컨테이너 -->
    <div class="main-container">
        <!-- 헬스케어 도메인의 정체성(Medical)을 시각화하는 시맨틱 아이콘 컴포넌트 마운트 -->
        <i class="fa-solid fa-notes-medical logo-icon"></i>
        
        <!-- 애플리케이션의 핵심 아이덴티티를 명시하는 헤딩(H1) 태그 -->
        <h1>MAS</h1>
        <!-- 사용자 친화적 서비스 슬로건 출력 및 마크업 개행 처리 -->
        <p>나와 우리 가족을 위한<br>1:1 지능형 의료 비서</p>

        <!-- 
          * 💡 [라우팅 및 인증 게이트웨이 네비게이션]
          * 1. href="/login": 기가입 유저의 세션 검증 및 메인 서비스 진입을 위한 라우터 트리거
          * 2. href="/register": 신규 유저의 데이터베이스(MariaDB) 자원 적재를 위한 폼 뷰 라우팅
          * CSS 버튼 계층화: btn-primary(채워진 버튼)와 btn-outline(테두리 버튼)으로 
            시각적 계층 구조(Visual Hierarchy)를 두어 주 행동(Primary Action)인 로그인을 직관적으로 강조함.
        -->
        <a href="/login" class="btn btn-primary">로그인</a>
        <a href="/register" class="btn btn-outline">회원가입</a>
    </div>

</body>
</html>