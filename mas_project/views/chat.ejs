<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>MAS AI Assistant</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; font-family: 'Malgun Gothic', sans-serif; margin: 0; padding: 0; }
        body { background-color: #f0f2f5; display: flex; justify-content: center; padding: 20px; height: 100vh; }
        .app-container { width: 100%; max-width: 450px; background: white; border-radius: 20px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); overflow: hidden; display: flex; flex-direction: column; position: relative; padding-bottom: 60px; }
        .header { background: #0056b3; color: white; padding: 20px; text-align: center; font-size: 1.2rem; font-weight: bold; }
        .header span { font-size: 0.9rem; font-weight: normal; opacity: 0.8; display: block; margin-top: 5px; }
        .tab-content { flex: 1; display: flex; flex-direction: column; overflow-y: auto; height: 100%; }
        .chat-window { flex: 1; padding: 20px; background-color: #f4f7f6; display: flex; flex-direction: column; gap: 15px; overflow-y: auto; }
        .msg { max-width: 85%; padding: 12px 16px; border-radius: 15px; font-size: 0.95rem; line-height: 1.5; word-wrap: break-word; }
        .msg.user { align-self: flex-end; background: #007bff; color: white; border-bottom-right-radius: 2px; }
        .msg.ai { align-self: flex-start; background: white; color: #333; border: 1px solid #e1e4e8; border-bottom-left-radius: 2px; }
        .badge { display: inline-block; background: #ffebee; color: #c62828; padding: 4px 10px; border-radius: 12px; font-size: 0.85rem; font-weight: bold; margin: 2px 4px 2px 0; }
        .input-area { display: flex; padding: 15px; background: white; border-top: 1px solid #eee; align-items: center; }
        .input-area input { flex: 1; padding: 12px; border: 1px solid #ddd; border-radius: 20px; outline: none; margin-right: 10px; }
        .input-area button.send-btn { padding: 10px 20px; background: #0056b3; color: white; border: none; border-radius: 20px; font-weight: bold; cursor: pointer; }
        .mypage-wrap { padding: 20px; background: #fff; }
        .profile-card { text-align: center; padding: 20px 0; border-bottom: 1px solid #eee; }
        .profile-pic { width: 80px; height: 80px; background: #e9ecef; border-radius: 50%; display: inline-block; line-height: 80px; font-size: 2rem; margin-bottom: 10px; }
        .menu-list { list-style: none; margin-top: 20px; }
        .menu-list li { padding: 15px 10px; border-bottom: 1px solid #f1f1f1; font-size: 1.05rem; cursor: pointer; color: #333; display: flex; justify-content: space-between; align-items: center; }
        .menu-list li:hover { background: #f8f9fa; }
        .menu-list li::after { content: '>'; color: #ccc; font-weight: bold; }
        .records-container { display: none; padding: 15px; background: #f8fafc; border-radius: 10px; margin-top: 10px; max-height: 300px; overflow-y: auto; border: 1px solid #e2e8f0; }
        .record-item { padding: 10px 0; border-bottom: 1px solid #e2e8f0; font-size: 0.9rem; cursor: pointer; transition: background-color 0.2s; }
        .record-item:hover { background-color: #e2e8f0; border-radius: 8px; padding-left: 10px; } 
        .record-item:last-child { border-bottom: none; }
        .record-date { color: #888; font-size: 0.8rem; margin-bottom: 4px; }
        .record-symptom { font-weight: bold; color: #333; }
        .record-disease { color: #c62828; margin-top: 2px; }

        /* --- [3] 하단 네비게이션 바 스타일 --- */
.bottom-nav { position: absolute; bottom: 0; width: 100%; height: 60px; background: white; border-top: 1px solid #ddd; display: flex; z-index: 999; }        .nav-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #888; cursor: pointer; font-size: 0.85rem; transition: 0.2s; }
        .nav-item.active { color: #0056b3; font-weight: bold; }
        .nav-icon { font-size: 1.3rem; margin-bottom: 2px; }
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 100; justify-content: center; align-items: center; }
        .modal-content { background: white; width: 90%; max-width: 400px; border-radius: 15px; padding: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); max-height: 80vh; display: flex; flex-direction: column; }
        .modal-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #f0f2f5; padding-bottom: 15px; margin-bottom: 15px; }
        .modal-title { font-weight: bold; font-size: 1.1rem; color: #0056b3; }
        .modal-close { background: none; border: none; font-size: 1.5rem; color: #888; cursor: pointer; }
        .modal-body { overflow-y: auto; font-size: 0.95rem; line-height: 1.6; color: #333; }
    </style>
</head>
<body>

<div class="app-container">
    <div class="header">
        🩺 MAS
        <span>1인 가구를 위한 지능형 의료 비서</span>
    </div>
    
    <div id="view-chat" class="tab-content" style="display: none;">
        <div class="chat-window" id="chat-window">
            <div class="msg ai">
                안녕하세요! MAS입니다. 😊<br>어디가 불편하신지 말씀해 주시면 든든한 동반자가 되어 드릴게요.
            </div>
        </div>
        <div class="input-area">
            <button id="micBtn" type="button" onclick="startSpeechRecognition()" style="background: none; border: none; font-size: 22px; cursor: pointer; color: #10b981; margin-right: 10px;">
                <i class="fa-solid fa-microphone"></i>
            </button>

            <input type="text" id="symptom" placeholder="증상을 입력하세요 (예: 머리가 아파요)" onkeypress="if(event.key === 'Enter') sendChat()">
            <button class="send-btn" onclick="sendChat()">전송</button>
            
        </div>
    </div>

    <div id="view-mypage" class="tab-content">
        <div class="mypage-wrap">
            <div class="profile-card">
                <div class="profile-pic">👤</div>
                <h3><%= user.username %> 님</h3>
                <p style="color: #666; font-size: 0.9rem; margin-top: 5px;">1인 가구 케어 모드 활성화 중</p>
            </div>
            <ul class="menu-list">
                <li onclick="toggleMedicalRecords()">나의 의료 기록 확인</li>
                <div id="records-box" class="records-container">
                    <p id="records-empty" style="text-align:center; color:#888; font-size:0.9rem;">기록을 불러오는 중입니다...</p>
                </div>
                <li onclick="location.href='/manage-places'">🏥 자주 가는 병원/약국</li>
                <li onclick="location.href='/emergency-contact'">긴급 연락처 (보호자) 설정</li>
                <li onclick="location.href='/health-alerts'">건강 알림 설정</li>
                <li onclick="alert('준비 중인 기능입니다.');">앱 설정</li>
                <li onclick="location.href='/logout'">🚪 로그아웃</li>
            </ul>
            
            <div style="margin-top: 25px; background: #f0fdf4; border: 1px dashed #22c55e; border-radius: 12px; padding: 15px;">
                <h4 style="color: #16a34a; margin-bottom: 8px; font-size: 14px;">📸 MAS AI 처방전/약 봉지 스캔</h4>
                <p style="font-size: 11px; color: #666; margin-bottom: 12px;">처방전이나 약 봉지 사진을 올리면 AI가 즉시 분석해 줍니다.</p>
        
                <div style="display: flex; gap: 5px;">
                    <input type="file" id="prescriptionFile" accept="image/*" style="font-size: 12px; flex: 1;">
                    <button onclick="uploadAndAnalyzeImage()" style="background: #22c55e; color: white; border: none; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: bold; cursor: pointer;">분석 시작</button>
                </div>

                <div id="aiLoading" style="display: none; font-size: 12px; color: #16a34a; font-weight: bold; margin-top: 10px; text-align: center;">🔄 AI가 사진 속 글자를 분석 중입니다...</div>
                <div id="analysisResult" style="display: none; margin-top: 12px; background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; font-size: 12px; line-height: 1.6; color: #333; max-height: 200px; overflow-y: auto; white-space: pre-wrap;"></div>
            </div>
        </div>
    </div>

    <div class="bottom-nav">
        <div class="nav-item active" id="nav-chat" onclick="switchTab('chat')">
            <div class="nav-icon">💬</div>상담하기
        </div>
        <div class="nav-item" style="color: #ef4444;" onclick="triggerSOS()">
            <div class="nav-icon">🚨</div>SOS 호출
        </div>
        <div class="nav-item" id="nav-mypage" onclick="switchTab('mypage')">
            <div class="nav-icon">👤</div>마이페이지
        </div>
    </div>
</div>

<div id="record-modal" class="modal-overlay" onclick="closeModalOnBgClick(event)">
    <div class="modal-content">
        <div class="modal-header">
            <span class="modal-title">상세 분석 가이드</span>
            <button class="modal-close" onclick="closeRecordModal()">&times;</button>
        </div>
        <div id="modal-body" class="modal-body"></div>
    </div>
</div>

<script>
    function switchTab(tabName) {
        document.getElementById('view-chat').style.display = 'none';
        document.getElementById('view-mypage').style.display = 'none';
        document.getElementById('nav-chat').classList.remove('active');
        document.getElementById('nav-mypage').classList.remove('active');
        
        document.getElementById('view-' + tabName).style.display = 'flex';
        document.getElementById('nav-' + tabName).classList.add('active');
    }

    function openRecordModal(guideText) {
        const modal = document.getElementById('record-modal');
        const modalBody = document.getElementById('modal-body');
        modalBody.innerHTML = guideText ? guideText.replace(/\n/g, '<br>') : "상세 가이드 기록이 없습니다.";
        modal.style.display = 'flex';
    }

    function closeRecordModal() { document.getElementById('record-modal').style.display = 'none'; }
    function closeModalOnBgClick(event) { if (event.target.id === 'record-modal') closeRecordModal(); }

    async function toggleMedicalRecords() {
        const recordsBox = document.getElementById('records-box');
        if (recordsBox.style.display === 'block') {
            recordsBox.style.display = 'none';
            return;
        }
        recordsBox.style.display = 'block';
        
        try {
            const response = await fetch('/api/records', { method: 'POST' });
            const data = await response.json();
            recordsBox.innerHTML = ''; 

            if (data.length === 0) {
                recordsBox.innerHTML = '<p style="text-align:center; color:#888; font-size:0.9rem;">분석된 의료 기록이 없습니다.</p>';
                return;
            }

            data.forEach(item => {
                const itemDiv = document.createElement('div');
                itemDiv.className = 'record-item';
                itemDiv.dataset.guide = item.ai_guide; 
                itemDiv.onclick = function() { openRecordModal(this.dataset.guide); };
                itemDiv.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <div class="record-date">${item.date}</div>
                            <div class="record-symptom">증상: ${item.symptom_text}</div>
                            <div class="record-disease">진단: ${item.ai_predicted_disease}</div>
                        </div>
                        <button onclick="event.stopPropagation(); deleteRecord(${item.id})" style="background-color: #dc3545; color: white; border: none; padding: 5px 10px; border-radius: 5px; cursor: pointer; font-size: 0.8rem;">삭제</button>
                    </div>
                `;
                recordsBox.appendChild(itemDiv);
            });
        } catch (error) { recordsBox.innerHTML = '<p style="text-align:center; color:#c62828;">기록을 불러오지 못했습니다.</p>'; }
    }

    const chatWindow = document.getElementById('chat-window');
    const symptomInput = document.getElementById('symptom');

    function appendMessage(sender, text, isAiResult = false) {
        const msgDiv = document.createElement('div');
        msgDiv.className = `msg ${sender}`;
        if (isAiResult) msgDiv.innerHTML = text;
        else msgDiv.innerText = text;
        chatWindow.appendChild(msgDiv);
        chatWindow.scrollTop = chatWindow.scrollHeight;
    }

    function getFastLocation() {
        return new Promise((resolve) => {
            if (!navigator.geolocation) return resolve({ lat: null, lng: null });
            navigator.geolocation.getCurrentPosition(
                (pos) => resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
                (err) => resolve({ lat: null, lng: null }),
                { enableHighAccuracy: false, timeout: 3000, maximumAge: 600000 }
            );
        });
    }

    let cachedLocation = null;
    window.addEventListener('DOMContentLoaded', async () => {
        try { cachedLocation = await getFastLocation(); } catch (e) {}
    });

    let isVoiceMode = false;

    function startSpeechRecognition() {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRecognition) return alert("현재 브라우저는 음성 인식을 지원하지 않습니다.");

        const recognition = new SpeechRecognition();
        recognition.lang = 'ko-KR'; 
        recognition.interimResults = false;

        const micBtn = document.getElementById('micBtn');

        recognition.onstart = function() {
            micBtn.style.color = '#ef4444'; 
            symptomInput.placeholder = "듣고 있습니다..."; 
        };

        recognition.onresult = function(event) {
            symptomInput.value = event.results[0][0].transcript;
            isVoiceMode = true; 
            sendChat(); 
        };

        recognition.onspeechend = function() {
            recognition.stop();
            micBtn.style.color = '#10b981'; 
            symptomInput.placeholder = "증상을 입력하세요 (예: 머리가 아파요)";
        };

        recognition.start();
    }

    function speakAIResponse(text) {
        if (!window.speechSynthesis) return;
        const cleanText = text.replace(/[*#]/g, ''); 
        const utterance = new SpeechSynthesisUtterance(cleanText);
        utterance.lang = 'ko-KR'; 
        utterance.rate = 1.1;     
        window.speechSynthesis.speak(utterance);
    }

    async function sendChat() {
        const symptomText = symptomInput.value.trim();
        if(!symptomText) return alert("증상을 입력해주세요!");
        
        appendMessage('user', symptomText);
        symptomInput.value = '';
        
        const msgDiv = document.createElement('div');
        msgDiv.className = `msg ai`;
        msgDiv.innerHTML = '<span style="color:#888;">MAS가 분석 중입니다... ⏳</span>';
        chatWindow.appendChild(msgDiv);
        chatWindow.scrollTop = chatWindow.scrollHeight;

        try {
            let userLoc = cachedLocation || await getFastLocation(); 
            const response = await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ symptomText: symptomText, userLat: userLoc.lat, userLng: userLoc.lng })
            });
            
            const reader = response.body.getReader();
            const decoder = new TextDecoder("utf-8");
            let fullText = "";
            msgDiv.innerHTML = "";

            while (true) {
                const { done, value } = await reader.read();
                if (done) {
                    if (isVoiceMode) {
                        speakAIResponse(fullText);
                        isVoiceMode = false;
                    }
                    break; 
                }
                fullText += decoder.decode(value, { stream: true });
                msgDiv.innerHTML = fullText
                    .replace(/\[질환\]/g, '<span class="badge">🩺 예상 질환:</span> ')
                    .replace(/\[가이드\]/g, '<br><br><strong>💡 가이드</strong><br>')
                    .replace(/\n/g, '<br>');
                chatWindow.scrollTop = chatWindow.scrollHeight;
            }
        } catch (error) {
            msgDiv.innerHTML = "서버 통신에 실패했습니다.";
        }
    }

    async function deleteRecord(recordId) {
        if (!confirm("정말로 이 기록을 삭제하시겠습니까?")) return;
        try {
            const response = await fetch(`/api/records/${recordId}`, { method: 'DELETE' });
            const result = await response.json();
            if (response.ok && result.success) {
                document.getElementById('records-box').style.display = 'none';
                toggleMedicalRecords(); 
            } else alert(result.message || "삭제에 실패했습니다.");
        } catch (error) { alert("서버 통신에 실패했습니다."); }
    }

    async function uploadAndAnalyzeImage() {
        const fileInput = document.getElementById('prescriptionFile');
        const loadingDiv = document.getElementById('aiLoading');
        const resultDiv = document.getElementById('analysisResult');

        if (!fileInput.files || fileInput.files.length === 0) return alert('사진 파일을 선택해 주세요!');

        loadingDiv.style.display = 'block';
        resultDiv.style.display = 'none';
        
        const formData = new FormData();
        formData.append('prescriptionImage', fileInput.files[0]);

        try {
            const response = await fetch('/api/analyze-prescription', { method: 'POST', body: formData });
            const data = await response.json();

            if (response.ok && data.success) {
                resultDiv.innerHTML = data.analysis;
                resultDiv.style.display = 'block';
            } else alert(data.error || '오류가 발생했습니다.');
        } catch (error) { alert('서버와 연결할 수 없습니다.'); } finally { loadingDiv.style.display = 'none'; }
    }

    async function triggerSOS() {
        if (!confirm("🚨 긴급 상황입니까? 등록된 보호자에게 알림을 전송합니다.")) return;
        try {
            const response = await fetch('/api/sos', { method: 'POST' });
            const result = await response.json();
            if (response.ok && result.success) alert("보호자에게 알림이 전송되었습니다.");
            else alert(result.message || "알림 전송에 실패했습니다.");
        } catch (error) { alert("서버 통신에 실패했습니다."); }
    }

async function triggerSOS() {
    if (!confirm("🚨 긴급 상황입니까? 등록된 보호자에게 SOS 알림을 전송합니다.")) return;

    try {
        const response = await fetch('/api/sos', { method: 'POST' });
        const result = await response.json();

        if (response.ok && result.success) {
            alert("보호자에게 긴급 알림이 전송되었습니다.");
        } else {
            alert(result.message || "알림 전송에 실패했습니다.");
        }
    } catch (error) {
        console.error("SOS 호출 에러:", error);
        alert("서버 통신에 실패했습니다.");
    }
}
// =================================================================
// 🎙️ 음성 비서 모듈 (STT & TTS)
// =================================================================
let isVoiceMode = false; 
let isRecording = false;
let recognition;

// 1. 음성 인식 (STT) 설정
const SpeechApi = window.SpeechRecognition || window.webkitSpeechRecognition;
if (SpeechApi) {
    recognition = new SpeechApi();
    recognition.lang = 'ko-KR';
    recognition.interimResults = false;

    recognition.onstart = () => {
        isRecording = true;
        document.getElementById('micBtn').innerText = '🛑';
        // 💡 chatInput을 symptom으로 변경!
        document.getElementById('symptom').placeholder = "듣고 있습니다... (종료하려면 🛑 클릭)";
    };

    recognition.onresult = (event) => {
        // 💡 chatInput을 symptom으로 변경!
        document.getElementById('symptom').value = event.results[0][0].transcript;
        isVoiceMode = true; 
        
        sendChat();
    };

    recognition.onend = () => {
        isRecording = false;
        document.getElementById('micBtn').innerText = '🎤';
        // 💡 chatInput을 symptom으로 변경!
        document.getElementById('symptom').placeholder = "증상을 입력하세요 (예: 머리가 아파요)";
    };
    recognition.onerror = (event) => console.error("음성 인식 에러:", event.error);
}

// 2. 마이크 켜기/끄기 토글 함수
function toggleSpeech() {
    if (!recognition) return alert("음성 인식을 지원하지 않는 브라우저입니다.");
    isRecording ? recognition.stop() : recognition.start();
}

// 3. AI 답변 읽어주기 (TTS) 함수
function speakAIResponse(text) {
    if (!window.speechSynthesis) return;
    const utterance = new SpeechSynthesisUtterance(text.replace(/[*#]/g, ''));
    utterance.lang = 'ko-KR';
    utterance.rate = 1.1; 
    window.speechSynthesis.speak(utterance);
}

</script>
</body>
</html>