# Server only. Obtain your own key; never expose it to the app client.
GEMINI_API_KEY=
# Optional generation model. Confirm account availability before use.
GEMINI_GENERATION_MODEL=
# Server only; decoded data.go.kr key. No EXPO_PUBLIC_ prefix. Not used by mock ingestion.
DATA_GO_KR_SERVICE_KEY=
# HTTP local-evidence API; public Supabase key is used server-side for JWT verification.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
RAG_HOST=127.0.0.1
RAG_PORT=8787
RAG_ALLOWED_ORIGINS=
# local (default) or isolated in-memory synthetic fixtures; production rejects synthetic.
RAG_CORPUS_MODE=local
# KDCA server-only preparation. Existing issued TOKEN; never paste a full URL.
KDCA_HEALTHINFO_5830_TOKEN=
# Reserved until the official secure transmission contract is confirmed.
KDCA_API_BASE_URL=
# Not an authorization switch: live transport is still unimplemented/blocked.
KDCA_LIVE_FETCH_ENABLED=false
# Server-only path; keep issued URLs outside Git/app/hosting upload directories.
# JSON: {"schema":1,"items":[{"contentId":"5830","issuedUrl":"<issued URL entered privately>"}]}
KDCA_ISSUED_URLS_FILE=
# Optional reviewed corpus snapshot, restored before serving (no external calls).
RAG_STATE_SECRET_FILE=
RAG_STATE_SHA256=
