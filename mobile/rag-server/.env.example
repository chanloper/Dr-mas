# Server only. Obtain your own key; never expose it to the app client.
GEMINI_API_KEY=
# Optional generation model. Confirm account availability before use.
GEMINI_GENERATION_MODEL=
# Server only; decoded data.go.kr key. No EXPO_PUBLIC_ prefix. Not used by mock ingestion.
DATA_GO_KR_SERVICE_KEY=
# HTTP local-evidence API; public Supabase key is used server-side for JWT verification.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
RAG_HOST=127.0.0.1
RAG_PORT=8787
RAG_ALLOWED_ORIGINS=
